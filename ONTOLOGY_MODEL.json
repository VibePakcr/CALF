  "model": {
    "causality": "NOT_EVALUATED",
    "constraints": [
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "record-fields",
        "rule": "Required fields are exact; unknown properties are rejected for each selected variant."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "record-identity",
        "rule": "Record IDs are unique. TASK has id=task. Other records bind a previously stored TASK."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "previous-target",
        "rule": "Stored relationship targets must already exist and be distinct. Forward and self references are rejected; stored relationship edges follow record order backwards."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "relation-domain-range",
        "rule": "The native allowed-pair predicate and task restrictions define each relation's source and target domains. Duplicate type/target pairs are rejected."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "proposal-state",
        "rule": "Agent-origin records are proposed. A proposed record cannot contain accepted relationships."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "contract",
        "rule": "Registered scope and criteria are nonempty, bounded and unique. Paths are relative; criterion commands and environment keys are constrained."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "observed-task",
        "rule": "Observation-only TASK has empty scope and criteria; observing host activity does not create a work contract."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "check-binding",
        "rule": "CHECK names an existing criterion, matches its exact command and includes checks to its own TASK. Accepted CHECK requires collector origin."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "snapshot-and-receipt",
        "rule": "A complete snapshot has a SHA-256 digest and null reason; an incomplete snapshot has null digest and a string reason. Receipt numbers are finite, finish >= start, and nullable results are retained as unknown."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "host-bindings",
        "rule": "Host start/end/check/artifact variants bind their declared task revision, start, step, attempt and collected scope as applicable. Start, end and artifact variants require accepted collector origin."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "operator-review",
        "rule": "Review is an accepted operator-origin DECISION, targets a same-task non-DECISION record or its existing relation index, and requires a nonempty reason. It cannot promote a non-collector CHECK."
      },
      {
        "enforcedAt": [
          "APPEND"
        ],
        "id": "review-transition",
        "rule": "Every writer, including direct append and the review command, rejects accepting a record already projected as retracted. Legacy histories retain their original structural read format; no stored reviews are rewritten."
      },
      {
        "enforcedAt": [
          "APPEND",
          "LOAD"
        ],
        "id": "canonical-history",
        "rule": "Canonical markup, metadata binding, sequence and the full SHA-256 chain are checked. Append additionally requires the expected current head and rejects concurrent changes."
      },
      {
        "enforcedAt": [
          "ACTIVE_GRAPH_QUERY"
        ],
        "id": "active-graph",
        "rule": "Active dependencies require accepted records/relations. Retracted, superseded or conflicting evidence and unavailable/deep dependencies are not cleared as active."
      },
      {
        "enforcedAt": [
          "COMPLETION_QUERY"
        ],
        "id": "completion-boundary",
        "rule": "A well-formed record or stored completion declaration is not a current verdict. Current completion separately checks registered criteria, retained evidence, file scope and execution context."
      }
    ],
